---
import { lectures, lecturePath, lectureNumber } from '../data/course';
---

<section id="sections" class="course-index" aria-labelledby="outline-title">
  <header>
    <h2 id="outline-title">The sections</h2>
    <span class="eyebrow">Course outline</span>
  </header>
  <ol>
    {lectures.map((lecture) => (
      <li>
        <a href={lecturePath(lecture)}>
          <span class="number">{lectureNumber(lecture)}</span>
          <span class="lecture-title">{lecture.frontmatter.title}</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  h2 {
    font-size: var(--text-section);
    letter-spacing: -0.02em;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border-top: 1px solid var(--color-rule);
  }

  li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  a {
    display: grid;
    grid-template-columns: var(--space-12) minmax(0, 1fr) var(--space-6);
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-4);
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color var(--motion-duration);
  }

  a:hover,
  a:focus-visible {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .number {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .lecture-title {
    font-family: var(--font-reading);
    font-size: clamp(1.375rem, 1.1rem + 0.75vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .arrow {
    color: var(--color-accent);
    font-size: var(--text-body);
  }

  @media (max-width: 40rem) {
    header > .eyebrow {
      display: none;
    }

    a {
      grid-template-columns: var(--space-6) minmax(0, 1fr) var(--space-5);
      gap: var(--space-3) var(--space-4);
      padding: var(--space-6) 0;
    }

    .arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
