---
import { blockMetadata } from './metadata';
import type { BlockIdentity } from './metadata';
import Permalink from './Permalink.astro';
import ProofControls from './ProofControls.astro';

/** Native disclosure. Named summary and default body slots preserve supplied markup. */
interface Props extends BlockIdentity {
  kind?: 'proof' | 'hint';
  for?: string;
  open?: boolean;
}
const { id, kind = 'proof', open = false } = Astro.props;
const block = blockMetadata(Astro.props);
const label = block?.label ?? (kind === 'proof' ? 'Proof' : 'Hint');
---

<details id={id} class="disclosure-block note-target" data-note-disclosure data-note-block={block?.key} data-kind={kind} open={open}>
  <summary><Permalink block={block}><slot name="summary">{label}</slot></Permalink></summary>
  <div class="disclosure-content" data-disclosure-body>
    <slot />
  </div>
  {Astro.props.kind === 'proof' && <ProofControls />}
</details>

<style>
  .disclosure-block { margin-block: var(--space-6); border-block: 1px solid var(--color-rule); }
  summary {
    min-height: var(--space-12);
    padding: var(--space-3) var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-interface);
    font-size: var(--text-ui);
    cursor: pointer;
  }
  .disclosure-content { min-width: 0; padding: var(--space-2) var(--space-2) var(--space-5); }
  [data-kind="proof"] > .disclosure-content {
    margin-inline-start: var(--space-2);
    border-inline-start: 1px solid var(--color-rule);
    padding-inline-start: var(--space-4);
  }
  .disclosure-content :global(> p + :is(div, ol, ul)),
  .disclosure-content :global(> :is(div, ol, ul) + p) {
    margin-block-start: var(--space-3);
  }
  @media print {
    .disclosure-block { break-inside: auto; }
    .disclosure-block::details-content { display: block; content-visibility: visible; }
    .disclosure-content { display: block !important; }
  }
</style>
