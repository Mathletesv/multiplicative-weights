---
import { nextStepKey } from '../../scripts/keyboard-shortcuts';
---

<div class="proof-controls" data-proof-controls hidden>
  <button class="next-step" type="button" data-proof-next aria-keyshortcuts={nextStepKey}>
    Next step <kbd aria-hidden="true">{nextStepKey}</kbd>
  </button>
  <button type="button" data-proof-all>Show full proof</button>
  <span data-proof-progress role="status"></span>
</div>

<style>
  .proof-controls:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .proof-controls {
    margin-inline: var(--space-2);
    padding-block: var(--space-2) var(--space-4);
    color: var(--color-muted);
    font-family: var(--font-interface);
    font-size: var(--text-sm);
  }

  button {
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-panel);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    color: var(--color-accent);
    cursor: pointer;
  }

  button:hover { border-color: var(--color-accent); background: var(--color-accent-soft); }
  .next-step { border-color: var(--color-accent); background: var(--color-accent); color: var(--color-surface); }
  .next-step:hover { background: var(--color-accent-hover); }

  @media print { .proof-controls:not([hidden]) { display: none; } }
</style>

<style is:global>
  @media screen {
    [data-proof-hidden]:not(mtr) { display: none !important; }
    /* A collapsed table row still contributes to the equation's column widths. */
    mtr[data-proof-hidden] { visibility: collapse; }
  }
</style>
