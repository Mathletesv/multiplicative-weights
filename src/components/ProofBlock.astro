---
import DisclosureBlock from './blocks/DisclosureBlock.astro';
import type { BlockIdentity } from './blocks/metadata';

interface Props extends BlockIdentity { for?: string; open?: boolean }
---

<DisclosureBlock {...Astro.props} kind="proof">
  {Astro.slots.has('summary') && <slot name="summary" slot="summary" />}
  <slot />
</DisclosureBlock>
