---
import { lectures, lecturePath, lectureNumber } from '../data/course';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
---

<nav aria-label="Sections" class="course-navigation">
  <p class="eyebrow">The sections</p>
  <ol>
    {lectures.map((lecture) => (
      <li>
        <a
          href={lecturePath(lecture)}
          aria-current={currentSlug === lecture.frontmatter.slug ? 'page' : undefined}
        >
          <span class="number">{lectureNumber(lecture)}</span>
          <span>{lecture.frontmatter.title}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: var(--space-6) minmax(0, 1fr);
    gap: var(--space-3);
    border-left: 2px solid transparent;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-accent);
  }

  a[aria-current] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .number {
    padding-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
</style>
