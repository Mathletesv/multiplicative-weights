---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sitePath } from '../lib/paths';
import themeScript from '../scripts/site-theme.js?raw';

interface Props {
  title?: string;
  frontmatter?: { title?: string };
}

const title = Astro.props.title ?? Astro.props.frontmatter?.title ?? 'Multiplicative Weights';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeScript}></script>
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link rel="icon" href={sitePath('favicon.ico')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" class="site-container" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <p class="copy-status" data-copy-status role="status"></p>
  </body>
</html>

<script>
  import { installNoteNavigation } from '../scripts/note-navigation';
  installNoteNavigation(document, window);
</script>

<style>
  .copy-status {
    position: fixed;
    inset-block-end: var(--space-4);
    inset-inline-end: var(--gutter);
    z-index: 10;
    pointer-events: none;
    font-size: var(--text-sm);
  }

  .copy-status:not(:empty) {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-panel);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
  }

  @media print { .copy-status { display: none; } }
</style>
